---
import { navItems, offcanvasItems } from 'site-shell/src/nav';

interface Props {
  /** Path of the current page, used to mark the active nav item. */
  current?: string;
}

const { current = '/blog' } = Astro.props;
const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

{
  /*
  Element for element, this is blog-frontend/src/layout/Header.tsx. The
  wrappers matter: .shell-header__utility-bar is a space-between row that
  needs both a left and a right child to place its contents the way the SPA
  does, and .shell-header__main is what carries the 2px rule and the gradient
  under the wordmark.

  Assets come from the site root rather than this package. The Go proxy
  serves blog-frontend/public there, so both sides load one copy of home.svg
  instead of each shipping its own.
*/
}
<header class="shell-header">
  {
    /*
    The SPA carries an offscreen <h1> here because its routes may not have
    one of their own. Every blog page does -- the article title, or the
    index heading -- so that h1 is deliberately not reproduced: a second one
    on every article would compete with the article's own.
  */
  }
  <div class="shell-header__utility-bar">
    <div class="shell-header__utility-left">
      <a href="/" class="shell-header__home-btn" aria-label="Home">
        <img
          src="/home.svg"
          alt="Home"
          class="shell-header__home-icon"
          width="20"
          height="20"
        />
      </a>
      <span class="shell-header__date">{today}</span>
    </div>
    <div class="shell-header__utility-right">
      <div class="presence">
        <button
          type="button"
          class="presence__trigger"
          aria-label="Who is online"
        >
          <span class="presence__dot" aria-hidden="true">●</span>
          <span data-presence-count>0</span> online
        </button>
        <div class="presence__card" data-presence-card role="status"></div>
      </div>
    </div>
  </div>

  <div class="shell-header__main">
    <a href="/" class="shell-header__logo-btn">
      <span class="shell-header__logo">
        <span class="shell-header__logo-accent">KYLE PARK</span>
        <span class="shell-header__logo-tagline">Personal Website</span>
      </span>
    </a>
  </div>

  <nav class="shell-header__nav" aria-label="Main">
    <ul class="shell-header__nav-list">
      {
        navItems.map((item) => (
          <li class="shell-header__nav-item">
            <a
              href={item.href}
              class:list={[
                'shell-header__nav-link',
                item.variant && `shell-header__nav-link--${item.variant}`,
              ]}
              aria-current={item.href === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="shell-header__nav-item">
        <details class="shell-header__more">
          <summary class="shell-header__nav-link" aria-label="More navigation"
            >☰</summary
          >
          <ul class="shell-header__more-list">
            {
              offcanvasItems.map((item) => (
                <li>
                  <a href={item.href} class="shell-header__nav-link">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</header>

{
  /*
  The same live presence the home page's masthead shows, from the same
  module: the count, and the panel behind it. Without this the utility bar's
  right half was empty on the blog and filled on the home page, which was the
  one asymmetry left between the two mastheads.

  A bundled script rather than is:inline, so the shared module is imported
  once rather than reimplemented here - every piece of this site that was
  written twice has drifted at least once.
*/
}
<script>
  import { connectPresence } from 'site-shell/src/presence';
  import { renderPresenceCard } from 'site-shell/src/presence-card';

  const countEl = document.querySelector('[data-presence-count]');
  const cardEl = document.querySelector<HTMLElement>('[data-presence-card]');

  // The socket is served by the ingress proxy, which nothing in front of a
  // local `astro dev` is running.
  const local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);

  if (countEl && cardEl && !local) {
    connectPresence({
      origin: `${location.protocol === 'http:' ? 'ws' : 'wss'}://${location.host}`,
      path: location.pathname,
      onUpdate: (presence) => {
        countEl.textContent = String(presence.count);
        renderPresenceCard(cardEl, presence);
      },
    });
  }
</script>
