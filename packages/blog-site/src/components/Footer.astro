---
import { BASE } from '../config/site';

/*
  Element for element, this is blog-frontend/src/layout/Footer.tsx: a 2px
  black bar, then copyright left, tagline centre, social icons right, on the
  grey surface. The icons are the same files and in the same order, served by
  the Go proxy from blog-frontend/public at the site root so both sides load
  one copy rather than each shipping its own.

  The SPA's icons are <button>s calling window.open; these are anchors, which
  crawl and middle-click. RSS is the SPA's inline glyph rather than a text
  link, so the row reads as six icons on both sides.
*/
const social = [
  {
    href: 'https://kyle-park.notion.site',
    label: 'Notion',
    icon: '/notion-icon.svg',
  },
  {
    href: 'https://kyle-park-io.medium.com',
    label: 'Medium',
    icon: '/medium-icon.svg',
  },
  {
    href: 'https://www.linkedin.com/in/kyle-park-io',
    label: 'LinkedIn',
    icon: '/linkedin-icon.png',
  },
  {
    href: 'https://github.com/kyle-park-io',
    label: 'GitHub',
    icon: '/github-icon.png',
  },
  {
    href: 'https://t.me/kyleparkio',
    label: 'Telegram',
    icon: '/telegram-icon.svg',
  },
  { href: 'https://x.com/bcd_kyle', label: 'X', icon: '/x-icon.svg' },
];
---

<footer class="shell-footer">
  <div class="shell-footer__border-top"></div>

  <div class="shell-footer__content">
    <div class="shell-footer__copyright">
      <span class="shell-footer__copyright-text">
        © {new Date().getFullYear()} kyle-park-io. All rights reserved.
      </span>
    </div>

    <div class="shell-footer__tagline">
      <span class="shell-footer__tagline-text">✦ Crafted with passion ✦</span>
    </div>

    <div class="shell-footer__social">
      <a
        href={`${BASE}/rss.xml`}
        class="shell-footer__social-btn"
        aria-label="RSS feed"
      >
        <svg
          class="shell-footer__social-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="5" cy="19" r="1.75" fill="currentColor"></circle>
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
        </svg>
      </a>
      {
        social.map((item) => (
          <a
            class="shell-footer__social-btn"
            href={item.href}
            aria-label={item.label}
          >
            <img
              class="shell-footer__social-icon"
              src={item.icon}
              alt={item.label}
              width="20"
              height="20"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</footer>
