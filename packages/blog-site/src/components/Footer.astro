---
import { BASE } from '../config/site';

/*
  Mirrors the SPA footer (blog-frontend/src/layout/Footer.tsx): a rule, then
  copyright left, tagline centre, social icons right. The first version of this
  file was a centred list of text links, which is why the footer changed shape
  when a reader crossed into the blog.

  The icons are the same files the SPA uses. The Go proxy serves them from its
  own public/ at the site root, so both sides reference one copy rather than
  keeping duplicates in two packages.
*/
const social = [
  { href: `${BASE}/rss.xml`, label: 'RSS', icon: null },
  {
    href: 'https://github.com/kyle-park-io',
    label: 'GitHub',
    icon: '/github-icon.png',
  },
  {
    href: 'https://www.linkedin.com/in/kyle-park-io',
    label: 'LinkedIn',
    icon: '/linkedin-icon.png',
  },
  { href: 'https://x.com/bcd_kyle', label: 'X', icon: '/x-icon.svg' },
  {
    href: 'https://kyle-park.notion.site',
    label: 'Notion',
    icon: '/notion-icon.svg',
  },
  {
    href: 'https://medium.com/@kyle-park-io',
    label: 'Medium',
    icon: '/medium-icon.svg',
  },
];
---

<footer class="shell-footer">
  <div class="shell-footer__rule"></div>

  <div class="shell-footer__content">
    <span class="shell-footer__copyright">
      © {new Date().getFullYear()} kyle-park-io. All rights reserved.
    </span>

    <span class="shell-footer__tagline">✦ Crafted with passion ✦</span>

    <div class="shell-footer__social">
      {
        social.map((item) =>
          item.icon ? (
            <a
              class="shell-footer__social-btn"
              href={item.href}
              aria-label={item.label}
            >
              <img
                class="shell-footer__social-icon"
                src={item.icon}
                alt=""
                width="18"
                height="18"
                loading="lazy"
              />
            </a>
          ) : (
            <a
              class="shell-footer__social-btn shell-footer__social-btn--text"
              href={item.href}
            >
              {item.label}
            </a>
          ),
        )
      }
    </div>
  </div>
</footer>
