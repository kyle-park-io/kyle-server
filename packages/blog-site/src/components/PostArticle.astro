---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Toc from './Toc.astro';
import ProgressBar from './ProgressBar.astro';
import { readingMinutes } from '../lib/reading-time';
import { COPY, formatDate, listLinkPath, tagPath } from '../lib/i18n';

interface Props {
  post: CollectionEntry<'posts'>;
  /**
   * The folder this copy is served from: BASE for a live post, `${BASE}/archive`
   * for an archived one. The markdown download sits next to the page.
   */
  root: string;
}

const { post, root } = Astro.props;
const { Content, headings } = await render(post);
const lang = post.data.lang;
const copy = COPY[lang];
const minutes = readingMinutes(post.body ?? '', lang);
const iso = post.data.date.toISOString().slice(0, 10);
const shown = formatDate(post.data.date, lang);
const updatedShown = post.data.updated
  ? formatDate(post.data.updated, lang)
  : undefined;
---

<ProgressBar lang={lang} />

<div class="post-page">
  <article class="post" lang={lang}>
    <header class="post__header">
      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__meta">
        <time datetime={iso}>{shown}</time>
        <span class="post__dot">·</span>
        <span>{copy.readingTime(minutes)}</span>
        {updatedShown && <span class="post__dot">·</span>}
        {updatedShown && <span>{copy.updated(updatedShown)}</span>}
      </p>
      <ul class="post__tags">
        {
          post.data.tags.map((tag) => (
            <li>
              <a href={tagPath(lang, tag)}>#{tag}</a>
            </li>
          ))
        }
      </ul>
    </header>

    <slot name="notice" />

    {
      post.data.cover && (
        <figure class="post__cover">
          <Image
            src={post.data.cover}
            alt=""
            widths={[720, 1440]}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="post__content">
      <Content />
    </div>

    <footer class="post__footer">
      <a class="post__download" href={`${root}/${post.id}.md`} download>
        {copy.download}
      </a>
      <a class="post__back" href={listLinkPath(lang)}>{copy.back}</a>
    </footer>
  </article>

  <Toc headings={headings} lang={lang} />
</div>
