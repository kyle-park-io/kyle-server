---
import { COPY, listLinkPath, tagPath, type Lang } from '../lib/i18n';

interface Props {
  tags: Array<{ tag: string; count: number }>;
  active?: string;
  lang?: Lang;
}

const { tags, active, lang = 'ko' } = Astro.props;
---

<nav class="tag-bar" aria-label="Tags">
  <a
    href={listLinkPath(lang)}
    class:list={['tag-bar__item', !active && 'tag-bar__item--active']}
  >
    All
  </a>
  {
    tags.map(({ tag, count }) => (
      <a
        href={tagPath(lang, tag)}
        class:list={[
          'tag-bar__item',
          active === tag && 'tag-bar__item--active',
        ]}
      >
        #{tag} <span class="tag-bar__count">{COPY[lang].postCount(count)}</span>
      </a>
    ))
  }
</nav>
