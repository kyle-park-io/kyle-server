---
import type { CollectionEntry } from 'astro:content';
import { BASE } from '../config/site';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const iso = post.data.date.toISOString().slice(0, 10);
const shown = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
});
---

<!--
  The card's children are direct children of .post-row: the card is a flex
  column and `.post-row__meta { margin-top: auto }` pins the meta line to the
  bottom edge, which only works without an intervening wrapper.

  This used to open with an `01` / `02` counter. The index is not a sequence
  -- it is a reverse-chronological list that renumbers itself every time a
  post is published -- so the counter labelled nothing, and the home page has
  no numbering to match.
-->
<article class="post-row">
  <h2 class="post-row__title">
    <a href={`${BASE}/${post.id}`}>{post.data.title}</a>
  </h2>
  <p class="post-row__summary">{post.data.summary}</p>
  <div class="post-row__meta">
    <time datetime={iso}>{shown}</time>
    {post.data.lang === 'en' && <span class="post-row__lang">EN</span>}
    <ul class="post-row__tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a href={`${BASE}/tags/${tag}`}>#{tag}</a>
          </li>
        ))
      }
    </ul>
  </div>
</article>
