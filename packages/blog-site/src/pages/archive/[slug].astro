---
import { getCollection, getEntry } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import PostArticle from '../../components/PostArticle.astro';
import { archived } from '../../lib/posts';
import { BASE, SITE_NAME } from '../../config/site';
import { COPY, formatDate } from '../../lib/i18n';
import '../../styles/post.css';

export async function getStaticPaths() {
  const posts = archived(await getCollection('posts'), import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const next = post.data.supersededBy
  ? await getEntry('posts', post.data.supersededBy)
  : undefined;
if (post.data.supersededBy && !next) {
  throw new Error(
    `${post.id}: supersededBy "${post.data.supersededBy}" is not a post`,
  );
}
const copy = COPY[post.data.lang];
const written = formatDate(post.data.date, post.data.lang);
---

<Shell
  title={`${post.data.title} ${copy.archivedSuffix} | ${SITE_NAME}`}
  description={post.data.summary}
  canonicalPath={`${BASE}/archive/${post.id}`}
  ogType="article"
  lang={post.data.lang}
  current={BASE}
  noindex
>
  <PostArticle post={post} root={`${BASE}/archive`}>
    <aside class="post__archived" slot="notice">
      <p>{copy.archivedNotice(written)}</p>
      {
        next && (
          <p>
            {copy.newPost} <a href={`${BASE}/${next.id}`}>{next.data.title}</a>
          </p>
        )
      }
    </aside>
  </PostArticle>
</Shell>
