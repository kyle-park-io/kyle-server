---
import { getCollection } from 'astro:content';
import TagPage from '../../components/TagPage.astro';
import { listed, inLang } from '../../lib/posts';

// One page per tag used by a Korean post. A tag used only by English posts
// has no page here; it lives under /blog/en/tags.
export async function getStaticPaths() {
  const posts = inLang(
    listed(await getCollection('posts'), import.meta.env.DEV),
    'ko',
  );
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
---

<TagPage lang="ko" tag={tag!} />
