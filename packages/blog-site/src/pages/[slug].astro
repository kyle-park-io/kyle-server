---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Giscus from '../components/Giscus.astro';
import PostArticle from '../components/PostArticle.astro';
import { excludeDrafts } from '../lib/posts';
import { BASE, SITE_NAME } from '../config/site';
import '../styles/post.css';

export async function getStaticPaths() {
  // Archived posts keep a page here too, so links to the old address still
  // land: the page only forwards to /blog/archive/<slug>.
  const posts = excludeDrafts(
    await getCollection('posts'),
    import.meta.env.DEV,
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
if (post.data.archived) {
  return Astro.redirect(`${BASE}/archive/${post.id}`, 301);
}
---

<Shell
  title={`${post.data.title} | ${SITE_NAME}`}
  description={post.data.summary}
  canonicalPath={`${BASE}/${post.id}`}
  ogType="article"
  ogImage={post.data.cover?.src}
  lang={post.data.lang}
  current={BASE}
>
  <PostArticle post={post} root={BASE} />

  <Giscus />
</Shell>
