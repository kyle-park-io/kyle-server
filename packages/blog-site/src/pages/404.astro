---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { sortByDateDesc, listed } from '../lib/posts';
import { BASE, SITE_NAME } from '../config/site';

// The proxy serves this page for every missing address under /blog, so it
// borrows the frame of the site's own 404 (blog-frontend NotFoundPage): the
// numeral between two rules, a title, two buttons. The first version used the
// index's heading classes without loading list.css, so it rendered as a bare
// browser-default heading and a blue underlined link.
//
// A blog reader who lands here was usually after a post, so the three newest
// listed posts sit under the buttons. Archived posts stay out, as on the index.
const recent = sortByDateDesc(
  listed(await getCollection('posts'), import.meta.env.DEV),
).slice(0, 3);

const shown = (date: Date): string =>
  date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Seoul',
  });
---

<Shell
  title={`글을 찾을 수 없습니다 | ${SITE_NAME}`}
  description="요청한 글이 없습니다."
  canonicalPath={`${BASE}/404`}
  current={BASE}
  noindex
>
  <div class="nf">
    <div class="nf__deco" aria-hidden="true">
      <span class="nf__line"></span>
      <span class="nf__num">404</span>
      <span class="nf__line"></span>
    </div>

    <h1 class="nf__title">글을 찾을 수 없습니다</h1>
    <p class="nf__msg">
      이 주소에는 글이 없습니다. 글 목록이나 아래 최근 글에서 찾아 주세요.
    </p>
    <p class="nf__addr" data-nf-addr hidden>
      <span class="nf__addr-label">요청한 주소</span>
      <code data-nf-path></code>
    </p>

    <div class="nf__actions">
      <a class="nf__btn nf__btn--primary" href={BASE}>글 목록 보기</a>
      <a class="nf__btn nf__btn--secondary" href="/">홈으로 가기</a>
    </div>

    {
      recent.length > 0 && (
        <section class="nf__recent" aria-labelledby="nf-recent">
          <h2 id="nf-recent" class="nf__recent-title">
            최근 글
          </h2>
          <ul class="nf__recent-list">
            {recent.map((post) => (
              <li class="nf__recent-item">
                <a href={`${BASE}/${post.id}`}>{post.data.title}</a>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {shown(post.data.date)}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Shell>

<script is:inline>
  // The page is static, so only the browser knows which address was asked for.
  (function () {
    var code = document.querySelector('[data-nf-path]');
    var row = document.querySelector('[data-nf-addr]');
    if (!code || !row) return;
    var path = location.pathname;
    try {
      path = decodeURI(path);
    } catch (e) {}
    code.textContent = path;
    row.hidden = false;
  })();
</script>

<style>
  .nf {
    max-width: 480px;
    margin: 0 auto;
    padding: 56px 0 24px;
    text-align: center;
    word-break: keep-all;
  }

  .nf__deco {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 32px;
  }

  .nf__line {
    display: block;
    width: 60px;
    height: 1px;
    background: var(--shell-fg);
  }

  .nf__num {
    font-family: var(--shell-serif);
    font-size: 72px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--shell-fg);
    font-variant-numeric: lining-nums;
  }

  .nf__title {
    font-family: var(--shell-sans);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--shell-fg);
    margin: 0 0 14px;
  }

  .nf__msg {
    font-family: var(--shell-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--shell-fg-soft);
    margin: 0 0 16px;
  }

  .nf__addr {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 10px;
    margin: 0 0 32px;
    padding: 8px 14px;
    background: var(--shell-surface);
    border: 1px solid var(--shell-rule);
    border-radius: 6px;
    font-size: 13px;
    color: var(--shell-muted);
  }

  .nf__addr[hidden] {
    display: none;
  }

  .nf__addr code {
    font-family: var(--shell-mono);
    font-size: 13px;
    color: var(--shell-fg);
    overflow-wrap: anywhere;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 48px;
  }

  .nf__btn {
    display: inline-block;
    padding: 13px 26px;
    font-family: var(--shell-sans);
    font-size: 15px;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition:
      background-color var(--shell-chrome-transition),
      border-color var(--shell-chrome-transition);
  }

  .nf__btn--primary {
    color: var(--shell-bg);
    background: var(--shell-fg);
    border: 1px solid var(--shell-fg);
  }

  .nf__btn--primary:hover {
    background: #2a2a2a;
  }

  .nf__btn--secondary {
    color: var(--shell-fg);
    background: transparent;
    border: 1px solid var(--shell-rule);
  }

  .nf__btn--secondary:hover {
    border-color: var(--shell-fg);
  }

  .nf__btn:focus-visible,
  .nf__recent-item a:focus-visible {
    outline: 2px solid var(--shell-accent);
    outline-offset: 3px;
  }

  .nf__recent {
    padding-top: 28px;
    border-top: 1px solid var(--shell-rule);
    text-align: left;
  }

  .nf__recent-title {
    font-family: var(--shell-sans);
    font-size: 14px;
    font-weight: 700;
    color: var(--shell-muted);
    margin: 0 0 8px;
  }

  .nf__recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nf__recent-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--shell-rule);
  }

  .nf__recent-item a {
    font-family: var(--shell-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--shell-fg);
    text-decoration: none;
  }

  .nf__recent-item a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nf__recent-item time {
    font-size: 13px;
    color: var(--shell-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .nf {
      padding-top: 32px;
    }

    .nf__num {
      font-size: 56px;
    }

    .nf__line {
      width: 40px;
    }

    .nf__title {
      font-size: 22px;
    }

    .nf__msg {
      font-size: 15px;
    }
  }

  @media (max-width: 420px) {
    .nf__actions {
      flex-direction: column;
    }

    .nf__btn {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>
