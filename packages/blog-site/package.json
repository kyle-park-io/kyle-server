{
  "name": "blog-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static blog at jungho.dev/blog",
  "license": "ISC",
  "author": "kyle-park-io <andy3638@naver.com>",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --port 4321",
    "preview": "astro preview --port 4321",
    "pretest": "rm -rf src/data/posts && mkdir -p src/data && cp -R __tests__/fixtures/posts src/data/posts && astro build",
    "test": "node --test __tests__/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.1",
    "cookie": "2.0.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "sharp": "0.35.4",
    "site-shell": "*"
  }
}
